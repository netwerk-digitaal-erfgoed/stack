{
  "name": "@ndes/iiif-images",
  "version": "0.2.2",
  "description": "Enriches SCHEMA-AP-NDE works with the dimensions and sizes of their representative IIIF image, as a quad transform for the search indexer.",
  "repository": {
    "url": "git+https://github.com/netwerk-digitaal-erfgoed/stack.git",
    "directory": "packages/iiif-images"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@ndes/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "@ndes/source": "./src/schema.ts",
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@lde/host-limiter": "^0.5.0",
    "@lde/iiif-image": "^0.2.0",
    "@lde/public-fetch": "^0.1.0",
    "@lde/resolver": "^0.8.0",
    "@rdfjs/types": "^2.0.1",
    "rdf-data-factory": "^2.1.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@lde/pipeline": "^0.48.0",
    "@lde/search": "^0.36.3"
  },
  "peerDependencies": {
    "@lde/search": ">=0.36.0"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "iiif-images"
  }
}
